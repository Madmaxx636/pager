#!/usr/bin/env bash
# pager: everyday control of your Pager server.   pager help
set -euo pipefail
HERE="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
cd "$HERE"
[ -f .env ] && { set -a; . ./.env; set +a; }
compose() { docker compose "$@"; }
BRIDGE_DB="postgres"; [ -n "${VAULT_DIR:-}" ] && BRIDGE_DB="bridgedb"
say() { printf '%s\n' "$*"; }
die() { printf 'Error: %s\n' "$*" >&2; exit 1; }
# Temporary files are removed when the command ends, however it ends. (Not with a RETURN trap: sourcing .env would fire it early.)
TMPD=""; trap '[ -n "$TMPD" ] && rm -rf "$TMPD"' EXIT
wipe() { docker run --rm -v "$1:/w" docker.io/library/postgres:16-alpine sh -c 'rm -rf /w/* /w/.[!.]* 2>/dev/null; true'; }
url() { # a real domain is reached over HTTPS (possibly through another proxy in front); an address on this network over plain HTTP
  if [[ "${PAGER_DOMAIN:-}" =~ ^(localhost|[0-9.]+|.*\.local)$ ]]; then echo "http://${PAGER_DOMAIN}:${HTTP_PORT##*:}"; else echo "https://${PAGER_DOMAIN}"; fi
}

waitfor() { # waitfor <service> [seconds]  (healthy, or running when the service has no health check)
  local s="$1" t="${2:-180}" i=0
  while [ $i -lt $t ]; do
    local h; h="$(compose ps --format '{{.Health}}' "$s" 2>/dev/null | head -1)"
    [ "$h" = "healthy" ] && return 0
    # Podman reports no health status: for the databases ask them directly.
    case "$s" in postgres|bridgedb) compose exec -T "$s" pg_isready -U pager >/dev/null 2>&1 && return 0;; esac
    [ -z "$h" ] && compose ps --status running "$s" 2>/dev/null | grep -q "$s" && [ "$s" != postgres ] && [ "$s" != bridgedb ] && return 0
    sleep 2; i=$((i+2))
  done
  return 1
}

cmd_status() {
  say "Pager server: $(url)"
  say "Version: $(cat ../VERSION 2>/dev/null || echo '?')"
  echo; compose ps --format 'table {{.Service}}\t{{.Status}}'
}

cmd_logs() { compose logs --tail "${LINES_SHOWN:-100}" -f "$@"; }

cmd_start() { compose up -d; }
cmd_stop() { compose stop; }
cmd_restart() { compose restart "$@"; }

cmd_codes() {
  say "Invite code (lets someone make a normal account): ${INVITE_CODE:-?}"
  say "Admin code  (makes an administrator, keep it private): ${ADMIN_INVITE_CODE:-?}"
}

cmd_update() {
  say "Getting the newest Pager…"
  git -C .. pull --ff-only
  ./scripts/build-web.sh
  local before; before="$(cat data/synapse/homeserver.yaml 2>/dev/null | md5sum)"
  ./scripts/setup.sh >/dev/null
  compose up -d --build
  # A bridge added by this update is only known to Synapse after it restarts.
  [ "$(cat data/synapse/homeserver.yaml 2>/dev/null | md5sum)" != "$before" ] && { say "Restarting Synapse to pick up a new bridge…"; compose restart synapse >/dev/null; }
  say "Updated to $(cat ../VERSION). Run 'pager status' to check everything is up."
}

cmd_doctor() { # read-only checks, safe to run any time and to paste when asking for help
  set +e +o pipefail   # a check that finds nothing must not stop the rest
  echo "--- pager $(cat ../VERSION 2>/dev/null)   $(date -u +%FT%TZ)   $(uptime -p)"
  echo "--- containers not running or unhealthy"
  compose ps --format '{{.Service}} {{.Status}}' | grep -vE ' Up .*(healthy)?$' | grep -v 'Up' || echo "(all up)"
  if [ -n "${VAULT_DIR:-}" ]; then echo "--- encrypted vault"; mountpoint "$VAULT_DIR" || echo "VAULT NOT MOUNTED: bridges cannot start"; fi
  echo "--- disk"; df -h . | tail -1
  echo "--- delivery queue to the bridges (should be small)"
  compose exec -T postgres psql -U pager -d synapse -Atc "select as_id||' '||state from application_services_state order by 1;" 2>/dev/null | tr '\n' ';'; echo
  compose exec -T postgres psql -U pager -d synapse -Atc "select as_id||': '||count(*) from application_services_txns group by as_id order by 1;" 2>/dev/null | tr '\n' ';'; echo
  echo "--- recent bridge problems (last 15 min)"
  for b in $(compose config --services | grep -vE '^(postgres|bridgedb|synapse|caddy|api|duckdns)$'); do
    echo "[$b]"; compose logs --since 15m "$b" 2>&1 | sed 's/\x1b\[[0-9;]*m//g' | grep -E 'ERR|FTL|WRN' | grep -v 'not invited to this room' | tail -3 | cut -c1-260 || true
  done
  echo "--- bridge bot encryption devices"
  compose exec -T postgres psql -U pager -d synapse -Atc "select user_id||' '||device_id from e2e_device_keys_json where user_id like '@%bot:%' order by 1;" 2>/dev/null
}

# ---- Backup and restore ------------------------------------------------------------------------------------------------
# Backups made on a schedule are locked with a public key, so the server can make them but cannot read them back: the private key stays with you.
# File layout: "PAGERBK2", a newline, the random file key locked with RSA (512 bytes for a 4096-bit key), then the AES-256 encrypted backup.
BK_MAGIC="PAGERBK2"; BK_HEAD=9; BK_WRAP=512
bk_lock() { # bk_lock <in file, or - for standard input> <out> <public key>
  local k src=(); k="$(openssl rand -hex 32)"; [ "$1" = - ] || src=(-in "$1")
  { printf '%s\n' "$BK_MAGIC"; printf %s "$k" | openssl pkeyutl -encrypt -pubin -inkey "$3" -pkeyopt rsa_padding_mode:oaep
    PASS="$k" openssl enc -aes-256-cbc -pbkdf2 -iter 200000 -salt -pass env:PASS "${src[@]}"; } > "$2"
}
bk_unlock() { # bk_unlock <in> <out> <private key>
  local k; k="$(dd if="$1" bs=1 skip=$BK_HEAD count=$BK_WRAP 2>/dev/null | openssl pkeyutl -decrypt -inkey "$3" -pkeyopt rsa_padding_mode:oaep)" || return 1
  [ -n "$k" ] || return 1
  tail -c +$((BK_HEAD + BK_WRAP + 1)) "$1" | PASS="$k" openssl enc -d -aes-256-cbc -pbkdf2 -iter 200000 -pass env:PASS -out "$2"
}
bk_is_keyed() { [ "$(head -c 8 "$1" 2>/dev/null)" = "$BK_MAGIC" ]; }

cmd_backup() {
  local auto=0 out="" pass="" noenc=0 usepass=0 keyed=0 a
  for a in "$@"; do case "$a" in --auto) auto=1;; --no-encrypt) noenc=1;; --passphrase) usepass=1;; *) out="$a";; esac; done
  local dir="$HERE/data/backups" pub="${BACKUP_PUBKEY:-$HERE/data/backup-public.pem}" keep="${BACKUP_KEEP:-2}"
  if [ $auto = 1 ]; then
    [ -f "$pub" ] || die "No backup key at $pub (see scripts/backup-schedule.sh)"
    mkdir -p "$dir"; out="$dir/pager-backup-$(date +%Y%m%d-%H%M%S).tar.enc"
  else
    # Locked with the backup key (the same one as the nightly backups) unless a passphrase is asked for; unencrypted only with --no-encrypt.
    if [ $noenc = 0 ] && [ $usepass = 0 ] && [ -f "$pub" ]; then keyed=1; out="${out:-$HOME/pager-backup-$(date +%Y%m%d-%H%M%S).tar.enc}"
    elif [ $noenc = 0 ]; then
      [ -t 0 ] || die "No backup key at $pub and no terminal to ask for a passphrase. Set the key up (scripts/backup-schedule.sh) or use --no-encrypt on purpose."
      out="${out:-$HOME/pager-backup-$(date +%Y%m%d-%H%M%S).tar.enc}"
      read -r -s -p "Passphrase to lock this backup: " pass; echo; [ -n "$pass" ] || die "An empty passphrase would leave it unlocked. Use --no-encrypt if you mean that"
      local again; read -r -s -p "Again: " again; echo; [ "$pass" = "$again" ] || die "The passphrases don't match"; out="${out%.enc}.enc"
    else out="${out:-$HOME/pager-backup-$(date +%Y%m%d-%H%M%S).tar.gz}"
    fi
  fi
  local tmp; if [ $auto = 1 ]; then mkdir -p "$dir"; tmp="$(mktemp -d "$dir/.work.XXXXXX")"; else tmp="$(mktemp -d "${TMPDIR:-/var/tmp}/pager.XXXXXX")"; fi; TMPD="$tmp"
  say "Saving the databases…"
  for host in $(printf '%s\n' postgres "$BRIDGE_DB" | sort -u); do
    for db in $(compose exec -T "$host" psql -U pager -d postgres -Atc "select datname from pg_database where datname not in ('postgres','template0','template1')"); do
      compose exec -T "$host" pg_dump -U pager -Fc "$db" > "$tmp/$host--$db.dump"
    done
  done
  say "Saving settings, keys and files…"
  local items=(.env data/synapse data/bridges data/api data/caddy)
  # (a file that changes while it is read gives tar a warning, exit code 1: the copy is still good)
  tar -C "$HERE" -czhf "$tmp/files.tar.gz" "${items[@]}" 2>/dev/null || [ $? = 1 ] || tar -C "$HERE" -czhf "$tmp/files.tar.gz" "${items[@]:0:3}"
  printf 'pager-backup 1\nversion %s\ndate %s\nbridge-db-host %s\n' "$(cat ../VERSION 2>/dev/null)" "$(date -u +%FT%TZ)" "$BRIDGE_DB" > "$tmp/MANIFEST"
  if [ $auto = 1 ] || [ $keyed = 1 ]; then (cd "$tmp" && tar -cf - MANIFEST files.tar.gz ./*.dump) | bk_lock - "$out.part" "$pub" && mv "$out.part" "$out"
  elif [ -n "$pass" ]; then (cd "$tmp" && tar -cf all.tar MANIFEST files.tar.gz ./*.dump); PASS="$pass" openssl enc -aes-256-cbc -pbkdf2 -iter 200000 -salt -pass env:PASS -in "$tmp/all.tar" -out "$out"; else (cd "$tmp" && tar -cf all.tar MANIFEST files.tar.gz ./*.dump); gzip -c "$tmp/all.tar" > "$out"; fi
  chmod 600 "$out"
  say "Backup saved: $out ($(du -h "$out" | cut -f1))"
  if [ $auto = 1 ]; then
    # keep the newest few
    ls -1t "$dir"/pager-backup-*.tar.enc 2>/dev/null | tail -n +$((keep + 1)) | xargs -r rm -f --
    say "Kept the newest $keep backups in $dir."
  else
    if [ $keyed = 1 ]; then say "Locked with the backup key: only the private key can open it. Check it with: pager verify $out <private key>"
    elif [ -z "$pass" ]; then say "It is NOT encrypted: it holds your server's keys and your chats' data. Keep it somewhere private."; fi
    say "Restore it with: pager restore $out"
  fi
}

# Checks that a backup can be opened and read, without changing anything. Needs the private key (so run it where you keep it).
cmd_verify() {
  local file="${1:?Usage: pager verify <backup file> [private key]}" key="${2:-${PAGER_BACKUP_KEY:-}}"
  [ -f "$file" ] || die "No such file: $file"
  local tmp; tmp="$(mktemp -d "${TMPDIR:-/var/tmp}/pager.XXXXXX")"; TMPD="$tmp"
  if bk_is_keyed "$file"; then
    [ -f "$key" ] || die "This backup is locked with a key: pager verify <file> <private key file>"
    bk_unlock "$file" "$tmp/all.tar" "$key" || die "The key does not open this backup, or the file is damaged"
  elif [[ "$file" == *.enc ]]; then
    local pass; read -r -s -p "Backup passphrase: " pass; echo; PASS="$pass" openssl enc -d -aes-256-cbc -pbkdf2 -iter 200000 -pass env:PASS -in "$file" -out "$tmp/all.tar" || die "Wrong passphrase, or the file is damaged"
  else gzip -dc "$file" > "$tmp/all.tar"; fi
  tar -C "$tmp" -xf "$tmp/all.tar"
  grep -q '^pager-backup 1' "$tmp/MANIFEST" || die "That doesn't look like a Pager backup"
  tar -tzf "$tmp/files.tar.gz" >/dev/null || die "The files inside are damaged"
  local f n=0
  for f in "$tmp"/*.dump; do
    docker run --rm -i docker.io/library/postgres:16-alpine pg_restore -l < "$f" >/dev/null || die "The database dump $(basename "$f") is damaged"
    n=$((n + 1))
  done
  say "OK: $(grep '^date' "$tmp/MANIFEST" | cut -d' ' -f2), version $(grep '^version' "$tmp/MANIFEST" | cut -d' ' -f2), $n databases and the files all read back."
}

cmd_restore() {
  local file="${1:?Usage: pager restore <backup file>}"; [ -f "$file" ] || die "No such file: $file"
  say "This REPLACES everything on this server with the backup."
  read -r -p "Type restore to continue: " ok; [ "${ok,,}" = "restore" ] || { say "Cancelled."; exit 0; }
  local tmp; tmp="$(mktemp -d "${TMPDIR:-/var/tmp}/pager.XXXXXX")"; TMPD="$tmp"
  if bk_is_keyed "$file"; then
    local key="${PAGER_BACKUP_KEY:-}"; [ -f "$key" ] || read -r -p "Private key file for this backup: " key
    [ -f "$key" ] || die "No such key file"
    bk_unlock "$file" "$tmp/all.tar" "$key" || die "The key does not open this backup, or the file is damaged"
  elif [[ "$file" == *.enc ]]; then local pass; read -r -s -p "Backup passphrase: " pass; echo; PASS="$pass" openssl enc -d -aes-256-cbc -pbkdf2 -iter 200000 -pass env:PASS -in "$file" -out "$tmp/all.tar" || die "Wrong passphrase, or the file is damaged"
  else gzip -dc "$file" > "$tmp/all.tar"; fi
  tar -C "$tmp" -xf "$tmp/all.tar"
  grep -q '^pager-backup 1' "$tmp/MANIFEST" || die "That doesn't look like a Pager backup"
  say "Stopping the server…"; compose down --remove-orphans || true
  cp .env ".env.before-restore" 2>/dev/null || true
  say "Putting files back…"
  local d; for d in data/synapse data/api data/caddy; do [ -d "$d" ] && wipe "$HERE/$d"; done
  [ -L data/bridges ] && wipe "$(readlink -f data/bridges)" || { [ -d data/bridges ] && wipe "$HERE/data/bridges"; }
  wipe "$HERE/data/postgres"
  tar -C "$HERE" -xzf "$tmp/files.tar.gz"
  set -a; . ./.env; set +a
  BRIDGE_DB="postgres"; [ -n "${VAULT_DIR:-}" ] && { BRIDGE_DB="bridgedb"; mountpoint -q "$VAULT_DIR" || die "The encrypted vault is not open at $VAULT_DIR"; wipe "$VAULT_DIR/bridgedb"; }
  say "Starting the databases…"
  compose up -d postgres ${VAULT_DIR:+bridgedb}; waitfor postgres 120 || die "postgres did not start"; [ -n "${VAULT_DIR:-}" ] && { waitfor bridgedb 120 || die "bridgedb did not start"; }
  local f host db
  for f in "$tmp"/*.dump; do
    base="$(basename "$f" .dump)"; host="${base%%--*}"; db="${base#*--}"
    compose exec -T "$host" psql -U pager -d postgres -tAc "select 1 from pg_database where datname='$db'" | grep -q 1 \
      || compose exec -T "$host" psql -U pager -d postgres -c "CREATE DATABASE \"$db\" ENCODING 'UTF8' LC_COLLATE='C' LC_CTYPE='C' TEMPLATE=template0 OWNER pager" >/dev/null
    compose exec -T "$host" pg_restore -U pager -d "$db" --clean --if-exists --no-owner < "$f" >/dev/null 2>&1 || true
  done
  say "Starting everything…"; compose up -d --build
  say "Restored. Check with: pager status"
}

cmd_upgrade() { ./scripts/update-bridges.sh --apply "$@"; }

cmd_help() {
  cat <<H
pager status              what is running, and the address
pager logs [service]      follow the logs (e.g. pager logs whatsapp)
pager start | stop | restart [service]
pager update              get the newest Pager and restart
pager codes               show the invite and admin codes
pager upgrade [bridge]    install newer bridge versions (one at a time; one that does not start is put back)
pager doctor              checks that are safe to run any time; paste the output when asking for help
pager backup [file]       save everything, locked with the backup key (--passphrase asks for a passphrase instead; --no-encrypt leaves it unlocked)
pager backup --auto       the scheduled kind: locked with the public key, kept in data/backups
pager verify <file> [key] check that a backup opens and reads back
pager restore <file>      put a backup back (replaces what is here)
H
}

case "${1:-help}" in
  status) cmd_status;; logs) shift; cmd_logs "$@";; start) cmd_start;; stop) cmd_stop;; restart) shift; cmd_restart "$@";;
  codes) cmd_codes;; update) cmd_update;; doctor) cmd_doctor;; upgrade) shift; cmd_upgrade "$@";; backup) shift; cmd_backup "$@";; verify) shift; cmd_verify "$@";; restore) shift; cmd_restore "$@";;
  help|-h|--help) cmd_help;; *) cmd_help; exit 1;;
esac
