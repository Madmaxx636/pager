#!/usr/bin/env bash
# pager: everyday control of your Pager server.   pager help
set -euo pipefail
HERE="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
cd "$HERE"
[ -f .env ] && { set -a; . ./.env; set +a; }
compose() { docker compose "$@"; }
BRIDGE_DB="postgres"; [ -n "${VAULT_DIR:-}" ] && BRIDGE_DB="bridgedb"
say() { printf '%s\n' "$*"; }
die() { printf 'Error: %s\n' "$*" >&2; exit 1; }
wipe() { docker run --rm -v "$1:/w" docker.io/library/postgres:16-alpine sh -c 'rm -rf /w/* /w/.[!.]* 2>/dev/null; true'; }
url() { case "${PAGER_ADDRESS:-}" in http://*) echo "http://${PAGER_DOMAIN}:${HTTP_PORT:-80}";; *) echo "https://${PAGER_DOMAIN}";; esac; }

waitfor() { # waitfor <service> [seconds]  (healthy, or running when the service has no health check)
  local s="$1" t="${2:-180}" i=0
  while [ $i -lt $t ]; do
    local h; h="$(compose ps --format '{{.Health}}' "$s" 2>/dev/null | head -1)"
    [ "$h" = "healthy" ] && return 0
    # Podman reports no health status: for the databases ask them directly.
    case "$s" in postgres|bridgedb) compose exec -T "$s" pg_isready -U pager >/dev/null 2>&1 && return 0;; esac
    [ -z "$h" ] && compose ps --status running "$s" 2>/dev/null | grep -q "$s" && [ "$s" != postgres ] && [ "$s" != bridgedb ] && return 0
    sleep 2; i=$((i+2))
  done
  return 1
}

cmd_status() {
  say "Pager server: $(url)"
  say "Version: $(cat ../VERSION 2>/dev/null || echo '?')"
  echo; compose ps --format 'table {{.Service}}\t{{.Status}}'
}

cmd_logs() { compose logs --tail "${LINES_SHOWN:-100}" -f "$@"; }

cmd_start() { compose up -d; }
cmd_stop() { compose stop; }
cmd_restart() { compose restart "$@"; }

cmd_codes() {
  say "Invite code (lets someone make a normal account): ${INVITE_CODE:-?}"
  say "Admin code  (makes an administrator, keep it private): ${ADMIN_INVITE_CODE:-?}"
}

cmd_update() {
  say "Getting the newest Pager…"
  git -C .. pull --ff-only
  ./scripts/build-web.sh
  ./scripts/setup.sh >/dev/null
  compose up -d --build
  say "Updated to $(cat ../VERSION). Run 'pager status' to check everything is up."
}

cmd_doctor() { # read-only checks, safe to run any time and to paste when asking for help
  echo "--- pager $(cat ../VERSION 2>/dev/null)   $(date -u +%FT%TZ)   $(uptime -p)"
  echo "--- containers not running or unhealthy"
  compose ps --format '{{.Service}} {{.Status}}' | grep -vE ' Up .*(healthy)?$' | grep -v 'Up' || echo "(all up)"
  if [ -n "${VAULT_DIR:-}" ]; then echo "--- encrypted vault"; mountpoint "$VAULT_DIR" || echo "VAULT NOT MOUNTED: bridges cannot start"; fi
  echo "--- disk"; df -h . | tail -1
  echo "--- delivery queue to the bridges (should be small)"
  compose exec -T postgres psql -U pager -d synapse -Atc "select as_id||' '||state from application_services_state order by 1;" 2>/dev/null | tr '\n' ';'; echo
  compose exec -T postgres psql -U pager -d synapse -Atc "select as_id||': '||count(*) from application_services_txns group by as_id order by 1;" 2>/dev/null | tr '\n' ';'; echo
  echo "--- recent bridge problems (last 15 min)"
  for b in $(compose config --services | grep -vE '^(postgres|bridgedb|synapse|caddy|api|duckdns)$'); do
    echo "[$b]"; compose logs --since 15m "$b" 2>&1 | sed 's/\x1b\[[0-9;]*m//g' | grep -E 'ERR|FTL|WRN' | grep -v 'not invited to this room' | tail -3 | cut -c1-260
  done
  echo "--- bridge bot encryption devices"
  compose exec -T postgres psql -U pager -d synapse -Atc "select user_id||' '||device_id from e2e_device_keys_json where user_id like '@%bot:%' order by 1;" 2>/dev/null
}

# ---- Backup and restore ------------------------------------------------------------------------------------------------
cmd_backup() {
  local out="${1:-$HOME/pager-backup-$(date +%Y%m%d-%H%M%S).tar.gz}" pass=""
  if [ -t 0 ] && [ "${2:-}" != "--no-encrypt" ]; then
    read -r -s -p "Passphrase to lock this backup (empty = unencrypted): " pass; echo
    if [ -n "$pass" ]; then local again; read -r -s -p "Again: " again; echo; [ "$pass" = "$again" ] || die "The passphrases don't match"; out="${out%.enc}.enc"; fi
  fi
  local tmp; tmp="$(mktemp -d)"; trap 'rm -rf "$tmp"' RETURN
  say "Saving the databases…"
  for host in $(printf '%s\n' postgres "$BRIDGE_DB" | sort -u); do
    for db in $(compose exec -T "$host" psql -U pager -d postgres -Atc "select datname from pg_database where datname not in ('postgres','template0','template1')"); do
      compose exec -T "$host" pg_dump -U pager -Fc "$db" > "$tmp/$host--$db.dump"
    done
  done
  say "Saving settings, keys and files…"
  local items=(.env data/synapse data/bridges data/api data/caddy)
  tar -C "$HERE" -czhf "$tmp/files.tar.gz" "${items[@]}" 2>/dev/null || tar -C "$HERE" -czhf "$tmp/files.tar.gz" "${items[@]:0:3}"
  printf 'pager-backup 1\nversion %s\ndate %s\nbridge-db-host %s\n' "$(cat ../VERSION 2>/dev/null)" "$(date -u +%FT%TZ)" "$BRIDGE_DB" > "$tmp/MANIFEST"
  (cd "$tmp" && tar -cf all.tar MANIFEST files.tar.gz ./*.dump)
  if [ -n "$pass" ]; then PASS="$pass" openssl enc -aes-256-cbc -pbkdf2 -iter 200000 -salt -pass env:PASS -in "$tmp/all.tar" -out "$out"; else gzip -c "$tmp/all.tar" > "$out"; fi
  chmod 600 "$out"
  say "Backup saved: $out ($(du -h "$out" | cut -f1))"
  [ -z "$pass" ] && say "It is NOT encrypted: it holds your server's keys and your chats' data. Keep it somewhere private."
  say "Restore it with: pager restore $out"
}

cmd_restore() {
  local file="${1:?Usage: pager restore <backup file>}"; [ -f "$file" ] || die "No such file: $file"
  say "This REPLACES everything on this server with the backup."
  read -r -p "Type restore to continue: " ok; [ "${ok,,}" = "restore" ] || { say "Cancelled."; exit 0; }
  local tmp; tmp="$(mktemp -d)"; trap 'rm -rf "$tmp"' RETURN
  if [[ "$file" == *.enc ]]; then local pass; read -r -s -p "Backup passphrase: " pass; echo; PASS="$pass" openssl enc -d -aes-256-cbc -pbkdf2 -iter 200000 -pass env:PASS -in "$file" -out "$tmp/all.tar" || die "Wrong passphrase, or the file is damaged"
  else gzip -dc "$file" > "$tmp/all.tar"; fi
  tar -C "$tmp" -xf "$tmp/all.tar"
  grep -q '^pager-backup 1' "$tmp/MANIFEST" || die "That doesn't look like a Pager backup"
  say "Stopping the server…"; compose down --remove-orphans || true
  cp .env ".env.before-restore" 2>/dev/null || true
  say "Putting files back…"
  local d; for d in data/synapse data/api data/caddy; do [ -d "$d" ] && wipe "$HERE/$d"; done
  [ -L data/bridges ] && wipe "$(readlink -f data/bridges)" || { [ -d data/bridges ] && wipe "$HERE/data/bridges"; }
  wipe "$HERE/data/postgres"
  tar -C "$HERE" -xzf "$tmp/files.tar.gz"
  set -a; . ./.env; set +a
  BRIDGE_DB="postgres"; [ -n "${VAULT_DIR:-}" ] && { BRIDGE_DB="bridgedb"; mountpoint -q "$VAULT_DIR" || die "The encrypted vault is not open at $VAULT_DIR"; wipe "$VAULT_DIR/bridgedb"; }
  say "Starting the databases…"
  compose up -d postgres ${VAULT_DIR:+bridgedb}; waitfor postgres 120 || die "postgres did not start"; [ -n "${VAULT_DIR:-}" ] && { waitfor bridgedb 120 || die "bridgedb did not start"; }
  local f host db
  for f in "$tmp"/*.dump; do
    base="$(basename "$f" .dump)"; host="${base%%--*}"; db="${base#*--}"
    compose exec -T "$host" psql -U pager -d postgres -tAc "select 1 from pg_database where datname='$db'" | grep -q 1 \
      || compose exec -T "$host" psql -U pager -d postgres -c "CREATE DATABASE \"$db\" ENCODING 'UTF8' LC_COLLATE='C' LC_CTYPE='C' TEMPLATE=template0 OWNER pager" >/dev/null
    compose exec -T "$host" pg_restore -U pager -d "$db" --clean --if-exists --no-owner < "$f" >/dev/null 2>&1 || true
  done
  say "Starting everything…"; compose up -d --build
  say "Restored. Check with: pager status"
}

cmd_help() {
  cat <<H
pager status              what is running, and the address
pager logs [service]      follow the logs (e.g. pager logs whatsapp)
pager start | stop | restart [service]
pager update              get the newest Pager and restart
pager codes               show the invite and admin codes
pager doctor              checks that are safe to run any time; paste the output when asking for help
pager backup [file]       save everything (asks for a passphrase to lock it)
pager restore <file>      put a backup back (replaces what is here)
H
}

case "${1:-help}" in
  status) cmd_status;; logs) shift; cmd_logs "$@";; start) cmd_start;; stop) cmd_stop;; restart) shift; cmd_restart "$@";;
  codes) cmd_codes;; update) cmd_update;; doctor) cmd_doctor;; backup) shift; cmd_backup "$@";; restore) shift; cmd_restore "$@";;
  help|-h|--help) cmd_help;; *) cmd_help; exit 1;;
esac
