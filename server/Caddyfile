{$PAGER_DOMAIN} {
	encode zstd gzip

	handle /_matrix/* {
		reverse_proxy synapse:8008
	}
	handle /_synapse/client/* {
		reverse_proxy synapse:8008
	}
	handle /api/* {
		reverse_proxy api:8080
	}
	# The Pager web app (build it with: cd app && npm ci && npm run build)
	handle {
		root * /srv/app
		try_files {path} /index.html
		file_server
	}
}
