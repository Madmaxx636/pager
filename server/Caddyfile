{$PAGER_ADDRESS} {
	encode zstd gzip

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		X-Frame-Options SAMEORIGIN
		Strict-Transport-Security "max-age=15552000"
		-Server
	}

	handle /_matrix/* {
		reverse_proxy synapse:8008
	}
	handle /_synapse/client/* {
		reverse_proxy synapse:8008
	}
	handle /api/* {
		reverse_proxy api:8080
	}
	# Updates for the Android and desktop apps (see scripts/release.sh): version info, signature and the files themselves
	handle /updates/* {
		root * /srv
		header Cache-Control "no-cache"
		file_server
	}
	# The Pager web app (build it with: cd app && npm ci && npm run build)
	handle {
		root * /srv/app
		try_files {path} /index.html
		file_server
	}
}
